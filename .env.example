# Copiez ce fichier en `.env` et renseignez ce dont vous avez besoin.
# `.env` est ignoré par git : vos valeurs ne partent nulle part.
#
# En développement local, ce fichier peut rester vide : l'application démarre
# sans aucune variable, sur une base PGlite créée dans `data/`.

# La base de données. Laissez vide pour PGlite en local.
# Pour un déploiement, il faut un vrai PostgreSQL persistant — PGlite ne
# survit pas à un hôte sans disque.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base

# Les deux variables qu'un déploiement exige, et seulement un déploiement.
# Le secret se tire avec : openssl rand -hex 32
# BETTER_AUTH_SECRET=
# APP_URL=https://votre-domaine.example

# Les clés de modèle ne se mettent PAS ici : elles se saisissent dans
# l'interface, qui les range hors du dépôt. Aucune clé ne doit apparaître
# dans un fichier suivi par git.
